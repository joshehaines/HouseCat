{
 "version": 1,
 "about": "HouseCat cat builder. Every sprite under base/ is painted WHITE; the coat, pattern, white markings, eyes and nose are applied in code with the coat recipe (docs/SPEC.md 'Coat recipe'; reference implementation tools/asset-pipeline/tint.py). Masks are 8-bit greyscale PNGs the same size as their sprite; a missing mask means 0 everywhere. The black cat (preset 'midnight') is the mascot and the default.",
 "root": "assets/cat/custom",
 "views": [
  "side",
  "tqfront",
  "front",
  "tqback"
 ],
 "paths": {
  "parts": "base/parts/cat_{body}_{view}_{part}.png",
  "part_names": [
   "head",
   "ear_far",
   "ear_near",
   "torso",
   "leg_front_far",
   "leg_front_near",
   "leg_back_far",
   "leg_back_near",
   "tail_up",
   "tail_curl",
   "tail_low"
  ],
  "swap_ears": "base/ears/ear_{ears}_{view}_{side}.png",
  "bobtail": "base/tails/bobtail_{view}_{pose}.png",
  "expression_heads": "base/expr/head_{heads}_{view}_{expr}.png",
  "expression_views": [
   "tqfront",
   "front",
   "side"
  ],
  "expressions": [
   "calm",
   "slowblink",
   "content",
   "surprised",
   "sleepy",
   "squint"
  ],
  "poses": "base/poses/cat_{body}_{pose}{variant}.png",
  "pose_names": [
   "sit_side",
   "sit_tqfront",
   "sit_front",
   "sit_back",
   "loaf_side",
   "loaf_tqfront",
   "sleep_curl",
   "stretch_side"
  ],
  "pose_variant": "'' for the body's own ears and tail; '__<ears>' (rounded, folded, tufted, oriental) or '__bobtail' for the four standard bodies",
  "whole_reference": "base/whole/cat_{body}_{view}_whole.png (breeds; the standard sets use cat/base/<set>/)",
  "pattern_mask": "masks/{pattern}/{same path as the sprite, without base/}",
  "white_mask": "masks/{white}/{same path as the sprite, without base/}",
  "features_mask": "masks/features/{same path as the sprite, without base/}"
 },
