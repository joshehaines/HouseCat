 "outfits": {
  "note": "Outfits (assets/outfits, 23 x 4 views) are layered over any look; nothing is painted per cat. Head items anchor between the ears on the head part, neck items at the neck, body items over the torso. 'fit' holds a per-body, per-view, per-slot nudge [dx, dy, scale] in the part's own pixels; all start neutral and are set once by eye in a debug screen. Head items sit 'tall_ears_lift' of the ear height higher on the tall ears listed, so a hat never cuts through them.",
  "tall_ears": [
   "siamese",
   "sphynx",
   "mainecoon",
   "oriental",
   "tufted"
  ],
  "tall_ears_lift": 0.35,
  "fit": {
   "short_slim": {
    "side": {
     "head": [
      0,
      0,
      1.0
     ],
     "neck": [
      0,
